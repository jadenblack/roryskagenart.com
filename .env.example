# Gemini API Key (Managed via Secrets panel)
GEMINI_API_KEY=

# Studio Admin Authentication (Optional custom initial configuration)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Supabase / PostgreSQL Integration (Configured via Vercel Integration)
NEXT_PUBLIC_VRCL_SUPA_SUPABASE_URL=
NEXT_PUBLIC_VRCL_SUPA_SUPABASE_PUBLISHABLE_KEY=
VRCL_SUPA_SUPABASE_ANON_KEY=
VRCL_SUPA_SUPABASE_SERVICE_ROLE_KEY=
VRCL_SUPA_POSTGRES_PRISMA_URL=
VRCL_SUPA_POSTGRES_URL_NON_POOLING=
VRCL_SUPA_SUPABASE_JWT_SECRET=

# Resend Email Integration (Configured via Settings / Secrets panel)
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# Outbound mail routing — server/lib/emailRouting.ts
#   live     = deliver to the real recipients (production only)
#   redirect = replace recipients with EMAIL_REDIRECT_TO and prefix "[PREVIEW]" (previews)
#   off      = send nothing
# Unset => inferred from VERCEL_ENV (production->live, preview->redirect, local->live).
EMAIL_MODE=
# Where `redirect` mode actually delivers. Required whenever EMAIL_MODE=redirect; if it is
# missing the message is SUPPRESSED rather than sent to the real recipient.
EMAIL_REDIRECT_TO=
# Studio notification recipients: primary address, plus comma-separated copies.
# ADMIN_EMAIL defaults to rory@ventureio.com; STUDIO_CC defaults to jaden@venturepilot.org.
# Set STUDIO_CC= (empty) to stop copying the second address.
STUDIO_CC=

# Scheduled off-site backup (Vercel Cron -> /api/cron/backup -> Vercel Blob)
# Shared secret presented by Vercel Cron as "Authorization: Bearer $CRON_SECRET".
# If this is unset the backup endpoint refuses every request (it fails closed).
CRON_SECRET=
# Blob store read/write token. Created by linking a Blob store to the project;
# falls back to the platform token on Vercel, so this is only needed locally.
# NEVER commit the value.
BLOB_READ_WRITE_TOKEN=

# Branded email (optional — sensible defaults are built in)
# Public origin used for links in emails; falls back to https://roryskagenart.com
SITE_URL=
# Absolute URL for the brand mark; falls back to ${SITE_URL}/android-chrome-192x192.png
BRAND_LOGO_URL=
