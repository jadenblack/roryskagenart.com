# Local agent workspace data (project memory, not application source)
.workbuddy-ai/

# Logical database backups — production data, never committed (see docs/runbooks/)
data/backups/

# Local render staging for the v3 media pass (scripts/wayback-render.ts) — regenerable, large,
# and derived from wayback/ and the bucket. Same reasoning as data/backups/ above.
data/staging/

# The recovered WordPress export (WP Migrate 2.6.9 / WP 6.4.2, exported 2023-12-17) — a one-time
# v3 ingest INPUT, not source. 522 MB / 9,029 files, and only ~1,828 JPGs under
# files/wp-content/uploads/ are real media; ~6,700 of those files are bundled plugin/theme code.
# Never committed — the derived extraction JSON under scripts/ is what gets committed.
# Timestamped with a wildcard so a re-export is covered too.
#
# ⚠️ The rest of wayback/ is deliberately NOT ignored: centraltexasmurals.com-v1/ (147 files) and
# roryskagen.com-v1/ (404 files) are TRACKED, and are the extraction inputs and the diff baseline.
wayback/centraltexasmuralsbyroryskagen-*/

# Serverless build artifacts (generated by vercel buildCommand from server.ts)
api/index.js.map
api/package-lock.json
